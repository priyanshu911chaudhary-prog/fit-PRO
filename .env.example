# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fit-pro?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@cluster.mongodb.net/fit-pro-test?retryWrites=true&w=majority

# Redis (Distributed Rate Limiting & High-Performance Caching)
REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication (HS256)
ACCESS_TOKEN_SECRET=your_access_token_secret_min_32_characters_long_for_security
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_characters_long_for_security
REFRESH_TOKEN_EXPIRATION=7d

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OAuth (Optional / Feature Flagged)
GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id

# Email Delivery (Mailtrap HTTPS API - Transactional Stream)
# In development and automated tests, EMAIL_PROVIDER defaults to "mock" (no API token required).
# For live Mailtrap HTTPS delivery, set EMAIL_PROVIDER=mailtrap and specify MAILTRAP_API_TOKEN.
# In production, EMAIL_PROVIDER=mailtrap is required with a verified sender domain.
EMAIL_PROVIDER=mock
MAILTRAP_API_TOKEN=your_mailtrap_api_token_here
EMAIL_FROM="Fit-PRO <hello@fit-pro.publicvm.com>"
# Dedicated secret for encrypting outbox tokens/links at rest (defaults to ACCESS_TOKEN_SECRET if unset)
EMAIL_PAYLOAD_SECRET=your_email_payload_encryption_secret_min_32_characters

# Web Push (VAPID keys for browser notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:support@fitpro.local
